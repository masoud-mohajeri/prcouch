{
  "name": "openai-tool-agent-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "evals": "tsx evals/run.ts",
    "evals:langfuse": "tsx evals/langfuse.ts",
    "langfuse:up": "docker compose up -d",
    "langfuse:down": "docker compose down",
    "langfuse:logs": "docker compose logs -f langfuse-web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@clack/prompts": "^0.11.0",
    "@langfuse/client": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "ai": "^5.0.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.0.0",
    "drizzle-orm": "^0.45.3",
    "p-map": "^7.0.8",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
