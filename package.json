{
  "name": "openai-tool-agent-boilerplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "start": "tsx src/cli/index.ts",
    "evals": "tsx evals/run.ts",
    "evals:laminar": "tsx evals/laminar.ts",
    "laminar:bootstrap": "bash scripts/laminar.sh bootstrap",
    "laminar:up": "bash scripts/laminar.sh up",
    "laminar:down": "bash scripts/laminar.sh down",
    "laminar:logs": "bash scripts/laminar.sh logs",
    "laminar:update": "bash scripts/laminar.sh update",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.0",
    "@clack/prompts": "^0.11.0",
    "@lmnr-ai/lmnr": "^0.8.48",
    "ai": "^5.0.0",
    "dotenv": "^16.0.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
