# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Override to a model your account can access.
OPENAI_MODEL=gpt-5-mini

# Optional OpenAI-compatible API endpoint. Defaults to https://api.openai.com/v1.
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# API protocol for the primary agent and evals: responses or chat.
# Defaults to responses for api.openai.com and chat for a custom base URL.
# Set this to responses only if your custom endpoint fully supports Responses.
# OPENAI_API_MODE=responses

# Required GitLab instance URL. Use https://gitlab.com for GitLab.com.
# Give this token only read_api (or fine-grained Merge Request: Read) access.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_read_only_gitlab_token
GITLAB_PROJECT=group/project

# Optional local JSON ledger for analyzed review comments. Keep this outside
# source control; the default is data/analyzed-comments.json.
# ANALYSIS_STORE_PATH=data/analyzed-comments.json

# Optional shared category/action policy. The default committed policy is
# config/comment-categories.json.
# COMMENT_CATEGORY_CONFIG_PATH=config/comment-categories.json

# Optional local directory for generated self-contained HTML reports.
# REPORT_OUTPUT_DIR=reports

# Laminar self-hosted evaluation settings. Start its local Docker stack with
# `npm run laminar:up`, then create a project and API key at http://localhost:5667.
LMNR_PROJECT_API_KEY=your_laminar_project_api_key
LMNR_BASE_URL=http://localhost
LMNR_HTTP_PORT=8000
LMNR_GRPC_PORT=8001
LMNR_FRONTEND_PORT=5667
