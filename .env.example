# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Override to a model your account can access.
OPENAI_MODEL=gpt-5-mini

# Required GitLab instance URL. Use https://gitlab.com for GitLab.com.
# Give this token only read_api (or fine-grained Merge Request: Read) access.
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=your_read_only_gitlab_token
GITLAB_PROJECT=group/project

# Laminar self-hosted evaluation settings. Start its local Docker stack with
# `npm run laminar:up`, then create a project and API key at http://localhost:5667.
LMNR_PROJECT_API_KEY=your_laminar_project_api_key
LMNR_BASE_URL=http://localhost
LMNR_HTTP_PORT=8000
LMNR_GRPC_PORT=8001
LMNR_FRONTEND_PORT=5667
